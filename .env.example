# GREMLIN configuration. Copy this file to `.env` beside app.py and fill it in.
#
# `.env` is git-ignored, so real credentials stay off GitHub. A genuine
# environment variable always wins over a value set here, so a host that exports
# one keeps deciding.

# --- Limble API -------------------------------------------------------------
# Read by the scheduled sync (python -m jobs.sync_limble) and by the developer
# dashboard's on-demand sync. Editing these takes effect on the next sync; the
# web app does not need restarting for them.
LIMBLE_CLIENT_ID=
LIMBLE_CLIENT_SECRET=
# Optional. Defaults to https://api.limblecmms.com/v2
# LIMBLE_BASE_URL=

# --- Developer dashboard ----------------------------------------------------
# The PIN that unlocks /developer. Read once when GREMLIN starts, so changing it
# needs a restart.
#
# Leave it unset and the PIN is 1336 -- a value published in this repository.
# That is fine for the read-only panels, but the Limble sync button writes to
# GREMLIN.db and spends the credentials above, so it stays disabled until this
# is set to something that is not 1336.
GREMLIN_DEV_PIN=

# Optional. Keeps developer-dashboard logins alive across restarts; without it a
# random key is generated each start and everyone re-enters the PIN.
# GREMLIN_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Note: read from this file by the scheduled sync only. The web app takes it
# from the real environment, so that reading configuration can never re-point a
# running app at a different database.
# GREMLIN_DB_PATH=C:\GREMLIN\GREMLIN.db
