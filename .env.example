# GREMLIN configuration. Copy this file to `.env` beside app.py and fill it in.
#
# `.env` is git-ignored, so real credentials stay off GitHub. A genuine
# environment variable always wins over a value set here, so a host that exports
# one keeps deciding.

# --- Limble API -------------------------------------------------------------
# Read by the scheduled sync (python -m jobs.sync_limble) and by the developer
# dashboard's on-demand sync. Editing these takes effect on the next sync; the
# web app does not need restarting for them.
LIMBLE_CLIENT_ID=
LIMBLE_CLIENT_SECRET=
# Optional. Defaults to https://api.limblecmms.com/v2
# LIMBLE_BASE_URL=

# --- User access and developer dashboard -----------------------------------
# Required on the first start of a new access-control database. These values
# create its first administrator account; there are no default credentials.
# After that, administrators manage viewer/editor/admin users from /developer,
# and changing these bootstrap values does not replace existing accounts.
GREMLIN_ADMIN_USERNAME=
GREMLIN_ADMIN_PIN=

# Optional. Defaults to accesscontrol.db in the same folder as GREMLIN.db
# (normally C:\GREMLIN). It stores password hashes and the protected-write audit trail.
# GREMLIN_ACCESS_DB_PATH=C:\GREMLIN\accesscontrol.db

# Optional. Set this ONLY when GREMLIN is served through a reverse proxy or TLS
# terminator, to the number of proxies it sits behind (usually 1). Login
# throttling is per client address; behind a proxy every user shares the proxy's
# address, so without this five wrong PINs from one person lock everybody out
# for fifteen minutes. Leave it unset when GREMLIN is reached directly --
# trusting X-Forwarded-For with no proxy in front lets any client forge its
# address and skip the limiter.
# GREMLIN_TRUSTED_PROXY_HOPS=1

# Optional. The key that signs the logged-in session cookie. Without it GREMLIN
# generates one on first start and keeps it in the access database, so every
# worker and every restart shares the same key already. Set this only to hold
# the key yourself; changing it signs everyone out.
# GREMLIN_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Note: read from this file by the scheduled sync only. The web app takes it
# from the real environment, so that reading configuration can never re-point a
# running app at a different database.
# GREMLIN_DB_PATH=C:\GREMLIN\GREMLIN.db
